# Discord bot token — https://discord.com/developers/applications
TOKEN=

# Last.fm API key — https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional: shown in media download embeds. If absent, the bot reuses or creates a server invite.
DISCORD_SERVER_INVITE=
# Optional: override the generated OAuth2 bot invite link in media download embeds.
BOT_INVITE_URL=
